# Backend Configuration for Development

# Flask settings
export FLASK_APP=main.py
export FLASK_ENV=development
export FLASK_DEBUG=1

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8060

# Frontend server (for CORS)
FRONTEND_URL=http://localhost:3000

# Model configuration
MODEL_DEVICE=cuda  # Set to 'cuda' if GPU available

# Simulation configuration
SIMULATION_TIMESTEP=0.1
SIMULATION_MAX_STEPS=1000
SIMULATION_DEFAULT_DURATION=60.0

# Logging
LOG_LEVEL=INFO
